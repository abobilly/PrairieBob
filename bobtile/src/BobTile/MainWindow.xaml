<Window x:Class="BobTile.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BobTile.ViewModels"
        xmlns:conv="clr-namespace:BobTile.Converters"
        mc:Ignorable="d"
        Title="BobTile - Tile Atlas Packer"
        Height="800" Width="700"
        MinHeight="650" MinWidth="550"
        WindowStartupLocation="CenterScreen"
        Icon="C:\Users\andre\lawchuck\artbob\bobtile\bobtile_icon.ico"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Subtle palette inspired by bobtile_icon.png -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F7F5FF" />
        <SolidColorBrush x:Key="AppAccentBrush" Color="#6366F1" />
        <SolidColorBrush x:Key="AppAccentBrushLight" Color="#8B5CF6" />
        <SolidColorBrush x:Key="AppBorderBrush" Color="#DAD6FF" />
        <SolidColorBrush x:Key="AppInputBorderBrush" Color="#C9C4FF" />
        <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AppTextBrush" Color="#1F1B3A" />

        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>

        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{StaticResource AppInputBorderBrush}" />
            <Setter Property="Background" Value="{StaticResource AppInputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="Padding" Value="6,3" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="{StaticResource AppInputBorderBrush}" />
            <Setter Property="Background" Value="{StaticResource AppInputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="Padding" Value="4,2" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#F2EEFF" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8E2FF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}" />
        </Style>

        <!-- Checkerboard pattern for transparency -->
        <DrawingBrush x:Key="CheckerboardBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#CCCCCC">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8"/>
                                <RectangleGeometry Rect="8,8,8,8"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- MODE SELECTOR -->
        <GroupBox Grid.Row="0" Header="Mode" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Margin="8">
                <RadioButton Content="Individual Tiles"
                             IsChecked="{Binding IsTilesMode}"
                             Margin="0,0,24,0"
                             ToolTip="Pack individual tile images into an atlas"/>
                <RadioButton Content="Combine Tilesets"
                             IsChecked="{Binding IsAtlasMode}"
                             ToolTip="Combine multiple existing tilesets into one large atlas"/>
            </StackPanel>
        </GroupBox>

        <!-- INPUT - TILES MODE -->
        <GroupBox Grid.Row="1" Header="Input - Individual Tiles" Margin="0,0,0,12"
                  Visibility="{Binding IsTilesMode, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="8">
                <!-- Folder mode -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" Content="Folder"
                                 IsChecked="{Binding IsFolderMode}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsFolderMode}"
                             Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="Browse..."
                            Command="{Binding BrowseFolderCommand}"
                            IsEnabled="{Binding IsFolderMode}"
                            Width="80"/>
                </Grid>

                <!-- File select mode -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" Content="Files"
                                 IsChecked="{Binding IsFileMode}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SelectedFilesDisplay, Mode=OneWay}"
                             IsReadOnly="True"
                             IsEnabled="{Binding IsFileMode}"
                             Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="Select..."
                            Command="{Binding SelectFilesCommand}"
                            IsEnabled="{Binding IsFileMode}"
                            Width="80"/>
                </Grid>
                <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,8,0,0"
                        Visibility="{Binding IsFileMode, Converter={StaticResource BoolToVis}}">
                    <ListBox x:Name="SelectedFilesList"
                             ItemsSource="{Binding SelectedFiles}"
                             MaxHeight="140"
                             AllowDrop="True"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseLeftButtonDown="OnListBoxPreviewMouseLeftButtonDown"
                             PreviewMouseMove="OnListBoxPreviewMouseMove"
                             Drop="OnSelectedFilesDrop">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Width="26" Height="22"
                                            Margin="6,0,0,0"
                                            Command="{Binding DataContext.RemoveSelectedFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Remove tile"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>
        </GroupBox>

        <!-- INPUT - ATLAS MODE -->
        <GroupBox Grid.Row="1" Header="Input - Tilesets to Combine" Margin="0,0,0,12"
                  Visibility="{Binding IsAtlasMode, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="8">
                <TextBlock Text="Select multiple tileset PNG files to combine into one atlas."
                           Foreground="Gray" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding SelectedTilesetsDisplay, Mode=OneWay}"
                             IsReadOnly="True"
                             Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Select Tilesets..."
                            Command="{Binding SelectTilesetsCommand}"
                            Width="110"/>
                </Grid>
                <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,8,0,0">
                    <ListBox x:Name="SelectedTilesetsList"
                             ItemsSource="{Binding SelectedTilesets}"
                             MaxHeight="140"
                             AllowDrop="True"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseLeftButtonDown="OnListBoxPreviewMouseLeftButtonDown"
                             PreviewMouseMove="OnListBoxPreviewMouseMove"
                             Drop="OnSelectedTilesetsDrop">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FileName}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding InputTileSize, StringFormat={}{0}x{0}}"
                                               Foreground="Gray"
                                               Margin="8,0,8,0"/>
                                    <Button Grid.Column="2"
                                            Content="⚙"
                                            Width="26" Height="22"
                                            Command="{Binding DataContext.EditTilesetSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Edit input tile size"/>
                                    <Button Grid.Column="3"
                                            Content="✕"
                                            Width="26" Height="22"
                                            Margin="6,0,0,0"
                                            Command="{Binding DataContext.RemoveTilesetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Remove tileset"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Source Padding:" VerticalAlignment="Center"
                           ToolTip="Padding between tiles in the source tilesets (usually 0)"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SourcePadding, UpdateSourceTrigger=PropertyChanged}"
                             Margin="8,0,0,0"/>
                </Grid>
                <CheckBox Content="Start each tileset on a new row"
                          IsChecked="{Binding StartTilesetsOnNewRow}"
                          Margin="0,8,0,0"
                          ToolTip="When enabled, each tileset begins on a new row. Unfilled columns remain transparent."/>
            </StackPanel>
        </GroupBox>

        <!-- SETTINGS GroupBox -->
        <GroupBox Grid.Row="2" Header="Settings" Margin="0,0,0,12">
            <StackPanel Margin="8">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tile Size -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <Label Content="Tile Size:" Padding="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding TileSizePresets}"
                                  SelectedItem="{Binding TileSize}"
                                  IsEditable="True"
                                  Text="{Binding TileSize, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Columns -->
                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                        <Label Content="Columns:" Padding="0,0,0,4"/>
                        <TextBox Text="{Binding ColumnsText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Enter number or 'auto'"/>
                    </StackPanel>

                    <!-- Padding -->
                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                        <Label Content="Output Padding:" Padding="0,0,0,4"/>
                        <TextBox Text="{Binding Padding, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Padding around each tile in output atlas"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Extrude edges by 1px"
                              IsChecked="{Binding ExtrudeEdges}"
                              ToolTip="Duplicates edge pixels to prevent texture bleeding"/>
                    <CheckBox Content="Resize images to tile size"
                              IsChecked="{Binding ResizeToTileSize}"
                              Margin="24,0,0,0"
                              ToolTip="Use nearest-neighbor scaling"
                              Visibility="{Binding IsTilesMode, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <Separator Margin="0,12,0,12"/>

                <StackPanel>
                    <CheckBox Content="Use default directories"
                              IsChecked="{Binding UseDefaultDirectories}"
                              ToolTip="Use default input/output directories when browsing"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="Default Input:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding DefaultInputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding UseDefaultDirectories}"
                                 Margin="8,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="Default Output:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding DefaultOutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding UseDefaultDirectories}"
                                 Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- OUTPUT GroupBox -->
        <GroupBox Grid.Row="3" Header="Output" Margin="0,0,0,12">
            <StackPanel Margin="8">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Folder:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                             Margin="8,0,8,0"/>
                    <Button Grid.Column="2" Content="Browse..."
                            Command="{Binding BrowseOutputCommand}"
                            Width="80"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Filename:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding OutputFilename, UpdateSourceTrigger=PropertyChanged}"
                             Margin="8,0,8,0"/>
                    <Label Grid.Column="2" Content=".png" VerticalAlignment="Center"/>
                </Grid>

                <CheckBox Content="Generate Tiled .tsx file"
                          IsChecked="{Binding GenerateTsx}"
                          ToolTip="Creates a Tiled-compatible tileset file"/>
            </StackPanel>
        </GroupBox>

        <!-- PREVIEW GroupBox -->
        <GroupBox Grid.Row="4" Header="Preview" Margin="0,0,0,12" MinHeight="260">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Preview panel with checkerboard background -->
                <Border Grid.Row="0"
                        Background="{StaticResource CheckerboardBrush}"
                        BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    MinHeight="220">
                    <Image Source="{Binding PreviewImage}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>

                <!-- Stats -->
                <TextBlock Grid.Row="1"
                           Text="{Binding StatsDisplay}"
                           Margin="0,8,0,0"
                           FontFamily="Consolas"/>
            </Grid>
        </GroupBox>

        <!-- STATUS bar -->
        <Grid Grid.Row="5" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"/>
            <ProgressBar Grid.Column="1"
                         Value="{Binding Progress}"
                         Maximum="100"
                         Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"
                         Height="20"/>
        </Grid>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Generate"
                    Command="{Binding GenerateCommand}"
                    Width="100" Height="32"
                    FontWeight="SemiBold"/>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
