    "defaultProject": "kimbar",
    "copilotCli": {
        "enabled": true,
        "allowedPaths": [
            "C:/Users/andre/lawchuck/artbob/SpudTile",
            "C:/Users/andre/lawchuck/badgey.org/kimbar/public/content",
            "C:/Users/andre/lawchuck/badgey.org/kimbar/specs"
